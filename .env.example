# Configuration de l'application (copier en .env)
APP_NAME="MAMTemplate API"
ENVIRONMENT="development"

# Base de données locale hors Docker (SQLite async) ou Docker (PostgreSQL asyncpg)
DATABASE_URL="sqlite+aiosqlite:///./mamtemplate.db"

# Paramètres des conteneurs Docker 3-Tiers (compose.yaml)
PRESENTATION_PORT=8080
POSTGRES_USER="mamtemplate"
POSTGRES_PASSWORD="mamtemplate_secret"
POSTGRES_DB="mamtemplate"
